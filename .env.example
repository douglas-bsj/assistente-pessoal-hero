# Configurações do J.A.R.V.I.S.
JARVIS_USER_NAME=Jackson
JARVIS_PORT=8000
TZ=America/Sao_Paulo

# Banco de Dados de Memória (pgvector)
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=stark_industries
POSTGRES_DB=jarvis_memory

# Ollama (Cérebro Local)
# No Docker no Windows/Linux, host.docker.internal conecta ao Ollama da máquina host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_AUTO_PULL=true

# Audição (Speech-to-Text com faster-whisper)
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=cpu

# Fala (Text-to-Speech com Edge-TTS)
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=+8%
